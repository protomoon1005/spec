# 이 파일을 복사해서 .env 로 쓴다. .env 는 git에 커밋하지 않는다 (.gitignore 처리됨).

# ================================
# Postgres (TimescaleDB + pgvector)
# ================================
POSTGRES_USER=spec
POSTGRES_PASSWORD=spec_dev_password
POSTGRES_DB=spec
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://spec:spec_dev_password@postgres:5432/spec

# ================================
# Redis (Celery broker + result backend)
# ================================
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ================================
# API (FastAPI)
# ================================
API_PORT=8000
API_RELOAD=true

# ================================
# Frontend (Next.js)
# ================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ================================
# LLM — Ollama 하나만 쓴다
# ================================
# 컨테이너로 띄우지 않는다. 호스트에 이미 떠 있는 Ollama(qwen3:8b)를 그대로 재사용한다.
# Docker Desktop for Windows는 host.docker.internal 을 기본 제공하므로 컨테이너에서 호스트로 바로 붙는다.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# 구조화 출력은 느리다 — 종목마다 선택지를 둔 스키마로 전략서를 만들면
# 한 번에 2분을 넘는다(2026-09-20 실측, qwen3:8b). 기본 120초로는 끊긴다.
LLM_REQUEST_TIMEOUT_SECONDS=300

# 재현성 — 샘플링 온도 0, 시드 고정 (app/core/config.py). 비우면 기본값(0 · 42).
LLM_TEMPERATURE=0
LLM_SEED=42

# ================================
# JWT (api) — access/refresh 발급
# ================================
JWT_SECRET=dev-insecure-secret-change-me-before-deploy
JWT_ALGORITHM=HS256
# 개발 중 Swagger 로 API 를 두드릴 때 30분마다 재로그인하기 싫으면
# 각자 .env 에서만 43200(30일) 등으로 올린다. 이 파일 기본값은 30 을 유지한다.
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_MINUTES=10080

# CELERY_TASK_ALWAYS_EAGER=true 로 두면 브로커 없이 태스크가 동기 실행된다.
# 워커 컨테이너 없이 단위 테스트를 돌릴 때만 켠다. 운영/개발 기본값은 false.
CELERY_TASK_ALWAYS_EAGER=false
