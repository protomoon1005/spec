# 이 파일을 복사해서 .env 로 쓴다. .env 는 git에 커밋하지 않는다 (.gitignore 처리됨).

# ================================
# Postgres (TimescaleDB + pgvector)
# ================================
POSTGRES_USER=spec
POSTGRES_PASSWORD=spec_dev_password
POSTGRES_DB=spec
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://spec:spec_dev_password@postgres:5432/spec

# ================================
# Redis (Celery broker + result backend)
# ================================
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ================================
# MinIO (모델 아티팩트 / 리포트 객체저장)
# ================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_REPORTS=reports

# ================================
# API (FastAPI)
# ================================
API_PORT=8000
API_RELOAD=true

# ================================
# Frontend (Next.js)
# ================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ================================
# LLM 백엔드 분기 — api는 LLM_BACKEND 값만 보고 LLMClient 구현체를 고른다
# ================================
# LLM_BACKEND=vllm | ollama
LLM_BACKEND=ollama

# --- Ollama (GPU 없는 팀원 기본값) ---
# 컨테이너로 띄우지 않는다. 호스트에 이미 떠 있는 Ollama(qwen3:8b)를 그대로 재사용한다.
# Docker Desktop for Windows는 host.docker.internal 을 기본 제공하므로 컨테이너에서 호스트로 바로 붙는다.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# --- vLLM (GPU 있는 팀원 전용, --profile gpu 로만 기동. 지금은 기동하지 않는다) ---
VLLM_PORT=8001
VLLM_MODEL=LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct
HF_TOKEN=

# ================================
# JWT (api) — access/refresh 발급, 3역할 RBAC (retail/pro/admin)
# ================================
JWT_SECRET=dev-insecure-secret-change-me-before-deploy
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_MINUTES=10080

# CELERY_TASK_ALWAYS_EAGER=true 로 두면 브로커 없이 태스크가 동기 실행된다.
# 워커 컨테이너 없이 단위 테스트를 돌릴 때만 켠다. 운영/개발 기본값은 false.
CELERY_TASK_ALWAYS_EAGER=false

# ================================
# 거시지표 수집 (M3 시장온도 관점)
# ================================
# FRED: https://fredaccount.stlouisfed.org/apikeys 에서 무료 발급
# ECOS: https://ecos.bok.or.kr/api/#/AuthKeyApply 에서 무료 발급
# 실제 키는 .env 에만 넣는다. 이 파일(.env.example)에는 절대 적지 않는다.
FRED_API_KEY=
ECOS_API_KEY=
