    { "patterns": ["한 달 새", "20일 수익률"], "indicator": "ret", "window": 20 },
    { "patterns": ["석 달 새", "3개월 새", "60일 수익률"], "indicator": "ret", "window": 60 },
    { "patterns": ["변동성", "출렁임"], "indicator": "vol", "window": 20 },
    { "patterns": ["거래량"], "indicator": "volume_ratio", "window": 20, "note": "평소(직전 20일 평균) 대비 배수" },
    { "patterns": ["VIX", "빅스", "공포지수"], "indicator": "vix" },
    { "patterns": ["산 가격", "매수가", "수익이", "손실이"], "indicator": "entry_return", "note": "팔 때 조건에서만" },
    { "patterns": ["거래일 뒤", "보유", "지나면"], "indicator": "holding_days", "note": "팔 때 조건에서만" }
