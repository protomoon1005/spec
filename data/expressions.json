    { "id": "ma_below", "patterns": ["{n}일선 아래면", "{n}일선 밑이면"],
      "verdict": "ok",
      "condition": { "left": { "indicator": "close", "of": "self" }, "op": "<", "right": { "indicator": "ma", "window": "{n}", "of": "self" } } },
    { "id": "oversold", "patterns": ["과매도"], "verdict": "ok",
      "condition": { "left": { "indicator": "rsi", "window": 14, "of": "self" }, "op": "<", "right": { "value": 30 } },
      "note": "v0.2 기본값: 과매도 = RSI 30" },
    { "id": "overbought", "patterns": ["과매수"], "verdict": "ok",
      "condition": { "left": { "indicator": "rsi", "window": 14, "of": "self" }, "op": ">", "right": { "value": 70 } },
      "note": "v0.2 기본값: 과매수 = RSI 70" },
    { "id": "stop_loss", "patterns": ["산 가격보다 {p}% 떨어지면", "{p}% 손실이면", "{p}% 빠지면 팔아", "손절 {p}%", "{p}% 떨어지면 손절"],
      "verdict": "ok",
      "condition": { "left": { "indicator": "entry_return", "of": "self" }, "op": "<=", "right": { "value": "-{p}" } },
      "note": "팔 때 조건에서만. 종가 기준" },
    { "id": "take_profit", "patterns": ["{p}% 오르면 팔아", "{p}% 수익이면", "익절 {p}%", "{p}% 오르면 익절"],
      "verdict": "ok",
      "condition": { "left": { "indicator": "entry_return", "of": "self" }, "op": ">=", "right": { "value": "{p}" } },
      "note": "팔 때 조건에서만. 종가 기준" },
    { "id": "hold_days", "patterns": ["{n}거래일 뒤에 팔아", "{n}일 보유", "{n}일 지나면 팔아", "{n}거래일 지나면 팔아"],
      "verdict": "ok",
      "condition": { "left": { "indicator": "holding_days", "of": "self" }, "op": ">=", "right": { "value": "{n}" } },
      "note": "v0.2: '5거래일 뒤에 팔아'는 보유 일수 5 이상이면 판다. 산 날 = 0일" },

    { "id": "golden_cross", "patterns": ["골든크로스"], "verdict": "clarify",
