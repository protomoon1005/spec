{
  "version": "demo-0.1",
  "note": "한국어 표현 사전 시드 (docs/demo-spec.md §B3). 명세화(LLM) 프롬프트에 그대로 들어간다. 여기의 매핑 결과는 반드시 B3 지표·연산자 사전 안의 값이어야 한다 (tests/test_dictionary.py 가 검사).",

  "direction_rules": {
    "note": "방향 표현은 '사건'(교차)과 '상태'(비교)를 구분한다. 교차는 전날엔 아니었다가 오늘 처음 넘어간 하루만 참, 상태는 조건이 유지되는 동안 매일 참.",
    "rules": [
      { "op": "cross_below", "kind": "event", "patterns": ["아래로 떨어지면", "아래로 내려가면", "밑으로 떨어지면", "밑으로 내려가면", "하향 돌파하면"],
        "example": { "phrase": "RSI 30 아래로 떨어지면", "condition": { "left": "RSI_14", "op": "cross_below", "right": 30 } } },
      { "op": "lt", "kind": "state", "patterns": ["아래면", "아래일 때", "밑이면", "밑일 때", "미만이면"],
        "example": { "phrase": "RSI 30 아래면", "condition": { "left": "RSI_14", "op": "lt", "right": 30 } } },
      { "op": "cross_above", "kind": "event", "patterns": ["위로 올라가면", "올라가면", "돌파하면", "상향 돌파하면", "뚫으면"],
        "example": { "phrase": "RSI 70 위로 올라가면", "condition": { "left": "RSI_14", "op": "cross_above", "right": 70 } } },
      { "op": "gt", "kind": "state", "patterns": ["위면", "위일 때", "넘으면", "초과면"],
        "example": { "phrase": "RSI 70 위면", "condition": { "left": "RSI_14", "op": "gt", "right": 70 } } }
    ],
    "unsupported": "'이하/이상'(같음 포함)은 연산자 사전에 없다. lt/gt 로 근사할지는 팀 결정 전까지 clarify."
  },

  "indicator_aliases": [
    { "patterns": ["종가", "주가", "가격"], "id": "CLOSE" },
    { "patterns": ["시가"], "id": "OPEN" },
    { "patterns": ["고가"], "id": "HIGH" },
    { "patterns": ["저가"], "id": "LOW" },
    { "patterns": ["거래량"], "id": "VOLUME" },
    { "patterns": ["5일선", "5일 이평", "5일 이동평균"], "id": "SMA_5" },
    { "patterns": ["10일선", "10일 이평", "10일 이동평균"], "id": "SMA_10" },
    { "patterns": ["20일선", "20일 이평", "20일 이동평균"], "id": "SMA_20" },
    { "patterns": ["60일선", "60일 이평", "60일 이동평균"], "id": "SMA_60" },
    { "patterns": ["120일선", "120일 이평", "120일 이동평균"], "id": "SMA_120" },
    { "patterns": ["12일 지수이평", "EMA 12", "12일 EMA"], "id": "EMA_12" },
    { "patterns": ["26일 지수이평", "EMA 26", "26일 EMA"], "id": "EMA_26" },
    { "patterns": ["RSI", "RSI 14"], "id": "RSI_14", "note": "기간 언급이 없으면 14. 14가 아닌 기간(예: RSI 9)은 사전에 없음 → clarify" },
    { "patterns": ["볼린저 상단", "볼린저밴드 상단", "볼밴 상단"], "id": "BB_UPPER_20" },
    { "patterns": ["볼린저 하단", "볼린저밴드 하단", "볼밴 하단"], "id": "BB_LOWER_20" },
    { "patterns": ["거래량 평균", "평균 거래량", "20일 평균 거래량"], "id": "VOL_SMA_20" },
    { "patterns": ["20일 최고가", "직전 20일 고점"], "id": "HIGH_N_20", "note": "당일 제외" },
    { "patterns": ["20일 최저가", "직전 20일 저점"], "id": "LOW_N_20", "note": "당일 제외" }
  ],

  "phrases": [
    { "id": "ma_break", "patterns": ["{n}일선 깨지면", "{n}일선 이탈하면", "{n}일선 무너지면"],
      "verdict": "ok", "condition": { "left": "CLOSE", "op": "cross_below", "right": "SMA_{n}" },
      "note": "종가 기준으로 고정 (장중 이탈은 보지 않음). 재서술에 '종가가'로 드러난다." },
    { "id": "ma_breakout", "patterns": ["{n}일선 돌파하면", "{n}일선 올라타면", "{n}일선 뚫으면"],
      "verdict": "ok", "condition": { "left": "CLOSE", "op": "cross_above", "right": "SMA_{n}" },
      "note": "종가 기준" },
    { "id": "golden_cross", "patterns": ["골든크로스"],
      "verdict": "ok", "condition": { "left": "SMA_5", "op": "cross_above", "right": "SMA_20" },
      "note": "기간 언급이 없으면 5일·20일 기본값. 이때 provenance.defaults_applied 에 해당 조건 경로(예: entry.conditions[0])를 넣는다." },
    { "id": "dead_cross", "patterns": ["데드크로스"],
      "verdict": "ok", "condition": { "left": "SMA_5", "op": "cross_below", "right": "SMA_20" },
      "note": "골든크로스와 동일하게 기본값 표시" },
    { "id": "oversold", "patterns": ["과매도"],
      "verdict": "ok", "condition": { "left": "RSI_14", "op": "lt", "right": 30 } },
    { "id": "overbought", "patterns": ["과매수"],
      "verdict": "ok", "condition": { "left": "RSI_14", "op": "gt", "right": 70 } },
    { "id": "volume_spike", "patterns": ["거래량 터지면", "거래량 폭발", "거래량 급증"],
      "verdict": "ok", "condition": { "left": "VOLUME", "op": "gt", "right": { "ref": "VOL_SMA_20", "mul": 2 } } },
    { "id": "half_half", "patterns": ["반반", "절반씩", "5:5"],
      "verdict": "ok", "universe_weights": [0.5, 0.5],
      "note": "종목이 정확히 2개일 때만. 1개 또는 3개면 clarify" },
    { "id": "stop_loss", "patterns": ["{p}% 떨어지면 손절", "{p}% 손실이면 팔아", "{p}% 빠지면 팔아"],
      "verdict": "ok", "exit_field": { "stop_loss": "{p}/100" },
      "note": "매수가 대비 종가 기준. 장중 저가는 보지 않는다" },
    { "id": "take_profit", "patterns": ["{p}% 오르면 익절", "{p}% 오르면 팔아", "{p}% 수익이면 팔아"],
      "verdict": "ok", "exit_field": { "take_profit": "{p}/100" },
      "note": "매수가 대비 종가 기준" },
    { "id": "max_hold", "patterns": ["{d}일 보유", "{d}일 뒤에 팔아", "{d}일 지나면 팔아"],
      "verdict": "ok", "exit_field": { "max_hold_days": "{d}" },
      "note": "거래일 기준, 매수 체결일이 1일째" },

    { "id": "pullback", "patterns": ["눌림목"], "verdict": "clarify",
      "question": "눌림목을 어떻게 볼까요? (예: 종가가 20일선 아래로 내려왔을 때, RSI가 40 아래일 때)" },
    { "id": "rsi_low_vague", "patterns": ["RSI 낮을 때", "RSI 낮으면"], "verdict": "clarify",
      "question": "RSI가 얼마 아래일 때를 낮다고 볼까요? (예: 30)" },
    { "id": "bottom", "patterns": ["바닥", "바닥에서"], "verdict": "clarify",
      "question": "바닥을 어떻게 판단할까요? (예: 직전 20일 최저가 아래로 내려갔을 때, RSI 30 아래일 때)" },
    { "id": "top", "patterns": ["고점", "꼭지"], "verdict": "clarify",
      "question": "고점을 어떻게 판단할까요? (예: RSI 70 위일 때, 볼린저 상단 위로 올라갔을 때)" },
    { "id": "smart_money", "patterns": ["세력", "작전"], "verdict": "reject", "reject_code": "UNSUPPORTED_CONCEPT",
      "detail": "'세력'은 가격·거래량 지표로 정의할 수 없는 개념입니다." },
    { "id": "future", "patterns": ["내일 오를", "오를 종목", "다음 주에 오를"], "verdict": "reject", "reject_code": "FUTURE_REF",
      "detail": "미래 가격을 조건으로 쓸 수 없습니다." },
    { "id": "news", "patterns": ["뉴스", "공시", "실적 좋으면"], "verdict": "reject", "reject_code": "UNSUPPORTED_CONCEPT",
      "detail": "뉴스·공시·실적은 데모 지표 사전에 없습니다." },
    { "id": "short", "patterns": ["공매도", "숏", "신용", "레버리지 걸어"], "verdict": "reject", "reject_code": "UNSUPPORTED_ACTION",
      "detail": "데모는 현금 매수/전량 매도만 지원합니다." },
    { "id": "no_exit", "patterns": [], "verdict": "reject", "reject_code": "NO_EXIT_RULE",
      "detail": "매도 조건·손절·익절·보유기간이 하나도 없으면 실행하지 않습니다." }
  ]
}
