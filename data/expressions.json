{
  "version": "0.2",
  "note": "한국어 표현 표 (docs/strategy-spec-v0.2.md). 매핑 결과는 전략 요소 사전(core/dictionary.py) 안의 값이어야 한다 (tests/test_dictionary.py 가 검사). 빈칸 채우기(LLM 프롬프트), 판정(연산자는 direction_rules·phrases 로 규칙이 정함), 4단계 근거 검사가 이 표를 쓴다. {n}·{p} 는 문장 속 숫자 자리.",

  "direction_rules": {
    "note": "v0.2 '~인 동안'과 '~하는 순간'. 동사로 정하고 되묻지 않는다. v0.2 표는 '이하면·밑이면·낮으면 → <= / <' 로 묶어 두었는데, 데모는 '이하'만 <= 로, '밑·아래·낮·미만'은 < 로 나눴다 (이상/위도 같은 방식). '올라가면'은 2026-11-02 팀 결정으로 추가 (cross_above).",
    "rules": [
      { "op": "<=", "kind": "state", "patterns": ["이하면", "이하일 때", "이하인 동안"] },
      { "op": "<",  "kind": "state", "patterns": ["밑이면", "아래면", "낮으면", "미만이면", "밑일 때", "아래일 때"] },
      { "op": ">=", "kind": "state", "patterns": ["이상이면", "이상일 때", "이상인 동안"] },
      { "op": ">",  "kind": "state", "patterns": ["위면", "높으면", "초과면", "위일 때"] },
      { "op": "cross_below", "kind": "event", "patterns": ["떨어지면", "깨지면", "내려가면", "이탈하면", "빠지면"] },
      { "op": "cross_above", "kind": "event", "patterns": ["넘으면", "뚫으면", "돌파하면", "올라서면", "올라오면", "올라가면", "터지면"] }
    ]
  },

  "of_aliases": [
    { "patterns": ["코스피가", "코스피200", "시장이", "지수가"], "of": "KOSPI200", "note": "v0.2 기본값 표: '코스피가…'라고 하면 코스피200" },
    { "patterns": ["코스닥이", "코스닥 지수"], "of": "KOSDAQ" },
    { "patterns": ["VIX", "빅스", "공포지수"], "of": "VIX" }
  ],

  "indicator_aliases": [
    { "patterns": ["종가", "주가", "가격"], "indicator": "close" },
    { "patterns": ["5일선", "5일 이평", "5일 이동평균"], "indicator": "ma", "window": 5 },
    { "patterns": ["10일선", "10일 이평", "10일 이동평균"], "indicator": "ma", "window": 10 },
    { "patterns": ["20일선", "20일 이평", "20일 이동평균"], "indicator": "ma", "window": 20 },
    { "patterns": ["60일선", "60일 이평", "60일 이동평균"], "indicator": "ma", "window": 60 },
    { "patterns": ["120일선", "120일 이평", "120일 이동평균"], "indicator": "ma", "window": 120 },
    { "patterns": ["RSI", "RSI 14"], "indicator": "rsi", "window": 14, "note": "기간 언급이 없으면 14 (v0.2 기본값)" },
    { "patterns": ["하루 새", "전날보다"], "indicator": "ret", "window": 1 },
