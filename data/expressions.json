    { "id": "market_fear", "patterns": ["시장이 불안하면", "공포", "패닉"], "verdict": "clarify",
      "question": "시장 불안을 VIX 몇 이상으로 볼까요 (20 / 30)?" },
    { "id": "pullback", "patterns": ["눌림목"], "verdict": "clarify",
