  "rebalance_aliases": [
    { "patterns": ["매달 초", "매월 초", "달마다", "매달", "매월", "한 달에 한 번"], "rebalance": "monthly_first" },
    { "patterns": ["중순", "15일"], "rebalance": "monthly_mid" },
    { "patterns": ["분기", "3개월마다", "석 달마다"], "rebalance": "quarterly" },
    { "patterns": ["매주", "주마다", "일주일마다"], "rebalance": "weekly" },
    { "patterns": ["5%p", "5%포인트", "5% 이상 벗어나"], "rebalance": "drift_5pp" }
  ],

  "meaningful_words": {
    "note": "4단계 근거 검사 '빠뜨린 내용'에서 원문에서 뽑는 낱말 (v0.2: 표현 표 + 사전 태그). 이 목록 + 위 표들의 구절 + data/tickers.json 별칭이 검사 범위다. 목록에 없는 낱말은 검사하지 않는다. 데모에는 전략 요소 사전 태그(kw: 91종)가 아직 없다.",
    "country": ["미국", "중국", "일본", "유럽", "인도", "베트남", "해외", "글로벌", "나스닥", "S&P"],
    "buy": ["사고", "사서", "사줘", "사면", "사자", "매수", "담아", "담고"],
    "sell": ["팔고", "팔아", "팔면", "매도", "손절", "익절", "청산", "정리"]
  },

  "phrases": [
    { "id": "ma_break", "patterns": ["{n}일선 깨지면", "{n}일선 이탈하면", "{n}일선 무너지면", "{n}일선 빠지면"],
      "verdict": "ok",
      "condition": { "left": { "indicator": "close", "of": "self" }, "op": "cross_below", "right": { "indicator": "ma", "window": "{n}", "of": "self" } },
      "note": "종가 기준 (장중 이탈은 보지 않음)" },
    { "id": "ma_breakout", "patterns": ["{n}일선 돌파하면", "{n}일선 뚫으면", "{n}일선 넘으면", "{n}일선 올라서면"],
      "verdict": "ok",
      "condition": { "left": { "indicator": "close", "of": "self" }, "op": "cross_above", "right": { "indicator": "ma", "window": "{n}", "of": "self" } } },
    { "id": "ma_above", "patterns": ["{n}일선 위면", "{n}일선 위일 때"],
